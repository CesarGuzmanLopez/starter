# Neovim Config Environment Variables
# Copy this to .env and fill in your values

# --- Minuet AI completion (Groq) ---
# API key de Groq: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Opcionales (los defaults ya apuntan a Groq / gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Proxy Cesar (legacy, ya no usado por Minuet) ---
# CESAR_PROXY_KEY=your-api-key-here
# CESAR_LLM_URL=https://your-llm-server.com/v1

# Optional: Java JDK path (auto-detected if not set)
# JAVA_HOME=/usr/lib/jvm/java-22-openjdk
